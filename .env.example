# ===== Copia este archivo como .env (cp .env.example .env) y completa los valores =====
# Endpoint de Amazon RDS (consola RDS > Bases de datos > cofrial-db > Conectividad y seguridad)
DB_HOST=cofrial-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASS=TuClaveSegura
DB_NAME=cofrial_db
DB_TIMEZONE=-03:00

# Backend
PORT=80
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# IA de costo cero: groq | gemini | local
#  - groq:   crea la clave en https://console.groq.com/keys      (modelo sugerido: llama-3.1-8b-instant)
#  - gemini: crea la clave en https://aistudio.google.com/apikey (modelo sugerido: gemini-3.5-flash-lite)
#  - local:  clasificador por reglas, sin internet (respaldo para la defensa)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=

# Grafana (usuario admin)
GRAFANA_ADMIN_PASS=Cofrial2026!
