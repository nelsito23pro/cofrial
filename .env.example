# ===== Copia este archivo como .env (cp .env.example .env) y completa los valores =====
# Endpoint de Amazon RDS (consola RDS > Bases de datos > cofrial-db > Conectividad y seguridad)
DB_HOST=cofrial-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASS=TuClaveSegura
DB_NAME=cofrial_db
DB_TIMEZONE=-03:00

# HTTPS con Caddy + Let's Encrypt. sslip.io da un dominio gratis a la IP: reemplaza los puntos de tu Elastic IP por guiones.
# Ejemplo: Elastic IP 34.238.200.122 -> DOMINIO=34-238-200-122.sslip.io
# Tienda y CRM: https://DOMINIO  ·  Grafana: https://grafana.DOMINIO
DOMINIO=

# Backend
PORT=80
SESSION_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# IA de costo cero: groq | gemini | local
#  - groq:   crea la clave en https://console.groq.com/keys      (modelo sugerido: openai/gpt-oss-20b)
#  - gemini: crea la clave en https://aistudio.google.com/apikey (modelo sugerido: gemini-3.5-flash-lite)
#  - local:  clasificador por reglas, sin internet (respaldo para la defensa)
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=

# Pasarela de pago Webpay Plus (clientes B2C)
#  - integracion: credenciales públicas de prueba de Transbank, tarjetas de prueba, sin dinero real (por defecto)
#  - produccion:  requiere contrato con Transbank y completar WEBPAY_COMMERCE_CODE / WEBPAY_API_KEY
WEBPAY_ENV=integracion
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
# URL pública de la tienda para el retorno desde Webpay (opcional; si se deja vacía se usa la dirección con que se abrió la tienda)
PUBLIC_URL=

# Grafana (usuario admin)
GRAFANA_ADMIN_PASS=Cofrial2026!
