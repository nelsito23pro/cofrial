  {
   "id": 10,
   "type": "timeseries",
   "title": "Temperatura de cámara por camión (en vivo)",
   "datasource": {
    "type": "mysql",
    "uid": "cofrial-mysql"
   },
   "gridPos": {
    "x": 0,
