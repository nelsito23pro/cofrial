  {
   "id": 12,
   "type": "table",
   "title": "Últimas alertas de ruptura de frío",
   "datasource": {
    "type": "mysql",
    "uid": "cofrial-mysql"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "cofrial-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT t.fecha_hora AS 'Fecha', t.camion_id AS 'Camión', t.temp_camara AS 'Temp °C', CONCAT(c.temp_min,' a ',c.temp_max) AS 'Rango permitido' FROM telemetria t JOIN camion c ON c.camion_id=t.camion_id WHERE t.alerta_ruptura_frio ORDER BY t.id_lectura DESC LIMIT 20"
    }
   ]
  },
  {
   "id": 13,
   "type": "bargauge",
   "title": "Pipeline CRM: monto por etapa",
   "datasource": {
    "type": "mysql",
    "uid": "cofrial-mysql"
   },
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "cofrial-mysql"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT e.nombre AS etapa, COALESCE(SUM(o.monto_estimado),0) AS monto FROM etapa_pipeline e LEFT JOIN oportunidad o ON o.id_etapa=e.id_etapa GROUP BY e.id_etapa, e.nombre ORDER BY e.orden"
