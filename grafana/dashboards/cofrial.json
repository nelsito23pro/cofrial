     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT UNIX_TIMESTAMP(fecha_hora) AS time, camion_id AS metric, temp_camara AS value FROM telemetria WHERE fecha_hora BETWEEN FROM_UNIXTIME($__unixEpochFrom()) AND FROM_UNIXTIME($__unixEpochTo()) ORDER BY fecha_hora"
